enum DeliveryPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model CustomerOrder {
  id          String @id @default(uuid())
  orderNumber String @unique @default(cuid())
  customerId  String

  // একটি checkout থেকে সর্বোচ্চ একটি customer order
  pendingCheckoutId String? @unique

  status                CustomerOrderStatus   @default(PENDING)
  paymentStatus         OrderPaymentStatus    @default(PENDING)
  deliveryPaymentStatus DeliveryPaymentStatus @default(PENDING)

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)

  shippingName     String
  shippingPhone    String
  shippingDivision String
  shippingDistrict String
  shippingUpazila  String
  shippingArea     String?
  shippingAddress  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer               User                    @relation(fields: [customerId], references: [id])
  pendingCheckout        PendingCheckout?        @relation(fields: [pendingCheckoutId], references: [id], onDelete: Restrict)
  rewardPointTransaction RewardPointTransaction?
  items                  CustomerOrderItem[]
  vendorOrders           VendorOrder[]
  payments               Payment[]

  @@index([customerId])
  @@index([status])
  @@index([deliveryPaymentStatus])
  @@index([createdAt])
}

model CustomerOrderItem {
  id              String @id @default(uuid())
  customerOrderId String
  productId       String
  vendorId        String

  productTitle String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  totalPrice   Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  customerOrder CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([customerOrderId])
  @@index([productId])
  @@index([vendorId])
}
