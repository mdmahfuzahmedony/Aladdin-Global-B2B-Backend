model VendorOrder {
  id          String @id @default(uuid())
  orderNumber String @unique @default(cuid())

  vendorId   String
  customerId String    

  customerOrderId String?
  customerOrder   CustomerOrder? @relation(fields: [customerOrderId], references: [id], onDelete: Restrict)

  status        CustomerOrderStatus @default(PENDING)
  paymentStatus OrderPaymentStatus  @default(PENDING)

  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  shippingName     String?
  shippingPhone    String?
  shippingAddress  String?
  shippingDivision String?
  shippingDistrict String?
  shippingUpazila  String?

  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  courierShipment CourierShipment?

  earning  VendorEarning?
  payments Payment[]

  vendor   Vendor @relation("VendorOrders", fields: [vendorId], references: [id], onDelete: Restrict)
  customer User   @relation("VendorOrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)

  items     VendorOrderItem[]
  deletedAt DateTime?

  @@index([vendorId, createdAt])
  @@index([customerId, createdAt])
  @@index([customerOrderId])
  @@index([status])
  @@index([paymentStatus])
}

model VendorOrderItem {
  id            String  @id @default(uuid())
  vendorOrderId String
  productId     String?

  productName  String
  productImage String?
  sku          String?
  unitPrice    Decimal  @db.Decimal(12, 2)
  quantity     Int
  totalPrice   Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  order   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product Product?    @relation("VendorOrderProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([vendorOrderId])
  @@index([productId])
}
