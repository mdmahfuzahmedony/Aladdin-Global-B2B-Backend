enum PaymentProvider {
  BKASH
  NAGAD
  BANK
  MOCK
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id                String  @id @default(uuid())
  customerOrderId   String?
  vendorOrderId     String?
  pendingCheckoutId String?
  customerId        String

  provider PaymentProvider
  purpose  String          @default("DELIVERY_CHARGE")
  amount   Decimal         @db.Decimal(12, 2)
  currency String          @default("BDT")
  status   PaymentStatus   @default(PENDING)

  transactionId    String?   @unique
  gatewayPaymentId String?   @unique
  bankReference    String?
  verifiedAt       DateTime?
  gatewayResponse  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerOrder   CustomerOrder?   @relation(fields: [customerOrderId], references: [id], onDelete: Restrict)
  vendorOrder     VendorOrder?     @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  pendingCheckout PendingCheckout? @relation(fields: [pendingCheckoutId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([customerOrderId, status])
  @@index([vendorOrderId, status])
  @@index([pendingCheckoutId, status])
  @@index([provider, status])
}
