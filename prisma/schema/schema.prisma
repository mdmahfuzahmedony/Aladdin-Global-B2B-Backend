generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VendorLocation {
  id          String   @id @default(uuid())
  vendorId    String   @unique
  division    String?
  district    String?
  upazila     String?
  area        String?
  fullAddress String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  latitude    Float?
  longitude   Float?
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorPayout {
  id                  String       @id @default(uuid())
  vendorId            String       @unique
  payoutMethod        PayoutMethod
  bankName            String?
  bankAccountNumber   String?
  bankAccountHolder   String?
  mobileBankingNumber String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  vendor              Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorSettings {
  id                    String    @id @default(uuid())
  vendorId              String    @unique
  description           String?
  phone                 String?
  email                 String?
  logoUrl               String?
  bannerUrl             String?
  deliveryAvailable     Boolean   @default(true)
  cityDeliveryCharge    Decimal   @default(0)
  outsideDeliveryCharge Decimal   @default(0)
  freeDeliveryThreshold Decimal   @default(0)
  deliveryTime          String?
  acceptOrders          Boolean   @default(true)
  autoConfirm           Boolean   @default(false)
  minimumOrder          Decimal   @default(0)
  cashOnDelivery        Boolean   @default(true)
  onlinePayment         Boolean   @default(false)
  storeActive           Boolean   @default(true)
  vacationMode          Boolean   @default(false)
  vacationStart         DateTime?
  vacationEnd           DateTime?
  showPhone             Boolean   @default(true)
  showEmail             Boolean   @default(true)
  showAddress           Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  vendor                Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorOpeningHour {
  id        String   @id @default(uuid())
  vendorId  String
  dayOfWeek Int
  enabled   Boolean  @default(true)
  open      String?
  close     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, dayOfWeek])
}

model ProductDelivery {
  id        String               @id @default(uuid())
  productId String               @unique
  scope     ProductDeliveryScope
  weightKg  Decimal?             @db.Decimal(10, 3)

  // নতুন ফিল্ড: Nationwide delivery charge (৳)
  nationwideCharge Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  rates   ProductDeliveryRate[]
}

model ProductDeliveryRate {
  id                 String          @id @default(uuid())
  productDeliveryId  String
  minDistanceKm      Int
  maxDistanceKm      Int
  firstKgCharge      Decimal         @db.Decimal(10, 2)
  additionalKgCharge Decimal         @db.Decimal(10, 2)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  productDelivery    ProductDelivery @relation(fields: [productDeliveryId], references: [id], onDelete: Cascade)

  @@unique([productDeliveryId, minDistanceKm])
  @@index([productDeliveryId])
}

model Media {
  id           String        @id @default(cuid())
  fileName     String
  originalName String
  type         MediaType
  category     MediaCategory
  url          String
  path         String
  mimeType     String
  size         Int
  altText      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@map("media")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  title       String
  description String?
  entityId    String?
  entityType  String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([entityType])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  title      String
  message    String
  entityId   String?
  entityType String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

enum CustomerOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum WholesalerOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum DropshipOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum AffiliateOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIAL
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAYABLE
  PAID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ShippingStatus {
  PENDING
  READY
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PayoutMethod {
  BANK
  BKASH
  NAGAD
}

enum ProductDeliveryScope {
  UPAZILA_BASED
  NATIONWIDE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaCategory {
  PRODUCT
  CATEGORY
  BRAND
  BANNER
  SLIDER
  STORE
  PROMOTION
  GENERAL
}

model ProductCoupon {
  id         String   @id @default(uuid())
  productId  String   @unique
  couponName String
  discount   Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model CustomerReward {
  id         String   @id @default(uuid())
  customerId String   @unique
  points     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([points])
}

model RewardPointTransaction {
  id              String   @id @default(uuid())
  customerId      String
  customerOrderId String   @unique
  points          Int
  amount          Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  customer User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}
