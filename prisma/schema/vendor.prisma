model Vendor {
  id               String       @id @default(uuid())
  userId           String       @unique
  storeName        String
  businessCategory String?
  status           VendorStatus @default(PENDING)
  commissionRate   Decimal      @default(0)

  nidNumber           String
  nidDocumentUrl      String?
  nidFrontDocumentUrl String?
  nidBackDocumentUrl  String?

  tradeLicenseNumber      String?
  tradeLicenseDocUrl      String?
  taxIdentificationNumber String?
  tinDocUrl               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  location     VendorLocation?
  openingHours VendorOpeningHour[]
  payout       VendorPayout?
  settings     VendorSettings?

  earnings           VendorEarning[]
  payoutTransactions VendorPayoutTransaction[]

  orders             VendorOrder[]       @relation("VendorOrders")
  customerOrderItems CustomerOrderItem[]

  storeChangeRequests VendorStoreChangeRequest[]
  googleDrive         VendorGoogleDrive?
  backups             VendorBackup[]
}

model VendorStoreChangeRequest {
  id                      String              @id @default(uuid())
  vendorId                String
  status                  ChangeRequestStatus @default(PENDING)

  // Requested new values
  storeName               String?
  ownerName               String?
  phone                   String?
  businessCategory        String?
  tradeLicenseNumber      String?
  nidNumber               String?
  taxIdentificationNumber String?

  // Current values at time of request
  oldStoreName            String?
  oldOwnerName            String?
  oldPhone                String?
  oldBusinessCategory     String?
  oldTradeLicenseNumber   String?
  oldNidNumber            String?
  oldTaxIdNumber          String?

  reason                  String?
  adminNote               String?

  reviewedBy              String?
  reviewedAt              DateTime?

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  vendor                  Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
